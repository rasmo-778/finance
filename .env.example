# Defines the environment in which the application is currently running.
# This value can be used to control runtime behavior and environment-specific settings.
ENVIRONMENT="production"

# Unique logical name assigned to the current application instance.
# Useful for identifying the running instance across logs, monitoring, and deployments.
INSTANCE_NAME="primary"

# Controls the default application mode.
# This setting may be used to determine how the application initializes and operates.
APPLICATION_MODE="standard"
